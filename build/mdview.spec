# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for MDView.app (personal use, ad-hoc signed).

Run via ``build/make-app.sh`` (which also repairs PyInstaller's mangled
QtWebEngineCore framework layout and handles the mandatory nested
``QtWebEngineProcess`` re-signing); it produces ``dist/MDView.app``
(PyInstaller 6.x writes the onedir BUNDLE at the top level, NOT inside the
sibling ``dist/MDView/`` COLLECT directory — that dir is neither signed
nor shipped).

The app icon comes from ``build/MDView.icns``, which ``make-app.sh`` compiles
with ``iconutil`` from the committed ``assets/icons/iconset`` PNGs (master:
``assets/mdview-icon.svg``) before PyInstaller runs; ``BUNDLE(icon=...)`` installs
it and its ``CFBundleIconFile`` key is gated afterwards.

Vendored KaTeX/Mermaid are deliberately **not** frozen into the bundle: they
are fetched once by ``mdview fetch-assets`` into the writable user data dir
(``~/Library/Application Support/MDView/vendor``) — on first launch when
missing — so the bundle stays small and re-fetching keeps working.  Only our
own ``static/`` and ``palettes/`` are shipped as datas; ``package_dir()``
resolves to ``Contents/Resources`` inside the bundle, where PyInstaller
unpacks them, while ``data_dir()``/``vendor_dir()`` always resolve to the
Application Support tree (see DESIGN.md §8–§9).
"""

from pathlib import Path

ROOT = Path(SPEC).resolve().parent.parent  # repo root (build/.. )
SRC = ROOT / "src"

# The app icon, generated by build/make-app.sh via
# `iconutil -c icns <staged .iconset> -o build/MDView.icns` from the committed
# assets/icons/iconset PNGs.  Absolute on purpose: BUNDLE resolves a *relative*
# ``icon`` against the SPEC FILE's own directory (PyInstaller 6.22.3,
# building/osx.py: ``os.path.join(CONF['specpath'], self.icon)``), so the
# literal ``build/MDView.icns`` would look for build/build/MDView.icns.
ICNS = ROOT / "build" / "MDView.icns"
assert ICNS.is_file(), (
    f"{ICNS} is missing — build/make-app.sh generates it with iconutil before "
    "PyInstaller runs; build the app through that script"
)

datas = [
    (str(SRC / "mdview" / "static"), "mdview/static"),
    (str(SRC / "mdview" / "palettes"), "mdview/palettes"),
]

a = Analysis(
    [str(SRC / "mdview" / "__main__.py")],
    pathex=[str(SRC)],
    binaries=[],
    datas=datas,
    hiddenimports=[
        "mdview.viewer",  # imported dynamically from mdview.__main__
        # Belt and braces for the render stack: PyInstaller's PySide6 hooks
        # collect QtWebEngineWidgets/QtWebEngineCore (plus QtWebEngineProcess
        # and its resources) automatically, but a bundle without the helper
        # shows a blank window, so the spec pins the intent explicitly.
        "PySide6.QtWebEngineWidgets",
        "PySide6.QtWebEngineCore",
    ],
    hookspath=[],
    runtime_hooks=[],
    excludes=["tkinter", "matplotlib", "PyQt6"],
    noarchive=False,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name="MDView",
    debug=False,
    strip=False,
    upx=False,
    console=False,  # windowed app; no Terminal window
    disable_windowed_traceback=False,
)

coll = COLLECT(
    exe,
    a.binaries,
    a.zipfiles,
    a.datas,
    strip=False,
    upx=False,
    name="MDView",
)

app = BUNDLE(
    coll,
    name="MDView.app",
    # PyInstaller copies this to Contents/Resources/MDView.icns.
    icon=str(ICNS),
    info_plist={
        # Which Resources entry Launch Services turns into the Finder/Dock icon.
        # PyInstaller defaults it to the icon's basename; it is spelled out here
        # from that same constant — so the two cannot drift — because make-app.sh
        # gates on the key resolving to the installed icns.
        "CFBundleIconFile": ICNS.name,
        # This is what fixes the menu bar showing "Python" when the app is
        # run unbundled: Launch Services uses CFBundleName for the app menu.
        "CFBundleName": "MDView",
        "CFBundleDisplayName": "MDView",
        "CFBundleIdentifier": "dev.personal.mdview",
        "CFBundleShortVersionString": "0.1.0",
        "CFBundleVersion": "1",
        "CFBundlePackageType": "APPL",
        "LSMinimumSystemVersion": "26.0",
        "NSHighResolutionCapable": True,
        "NSPrincipalClass": "NSApplication",
        "LSApplicationCategoryType": "public.app-category.productivity",
        "CFBundleDocumentTypes": [
            {
                "CFBundleTypeName": "Markdown Document",
                # Viewer role *and* Viewer rank (Phase 12): MDView views but
                # never edits Markdown, and Viewer rank is what makes Launch
                # Services offer it as a viewing handler for .md/.markdown
                # (double-click and multi-select "Open With") instead of
                # relegating it to an Alternate fallback.
                "CFBundleTypeRole": "Viewer",
                "LSHandlerRank": "Viewer",
                "LSItemContentTypes": [
                    # The real macOS Markdown UTI (reverse DNS of daringfireball
                    # .net); macOS reports .md files as this type, so the old
                    # "daringfiretown" typo made Launch Services never offer
                    # MDView for .md. Phase 13.
                    "net.daringfireball.markdown",
                    "public.markdown",
                ],
                # Must match core.document.SUPPORTED_SUFFIXES exactly.  No
                # "*" and no public.plain-text: MDView must not present
                # itself for every text file on the system.
                "CFBundleTypeExtensions": ["md", "markdown"],
            }
        ],
        # Double-click path: Launch Services delivers a QFileOpenEvent, which
        # MDViewApplication.event() turns into an open request (DESIGN.md §9).
        "NSDocumentsFolderUsageDescription": "MDView opens Markdown documents you choose.",
    },
)
